package java.math;

/** JML's specification of java.math.BigDecimal.
 *
 * The abstract state is the unscaled value and the scale (model fields _unscaled and _scale); the number is
 * _unscaled * 10^(-_scale), which is also the model field 'value'. The model fields are ESC-only (-RAC).
 * Not yet specified: the MathContext overloads, rounding beyond the bounds stated here, and the string forms.
 * Not modeled: the ArithmeticException thrown when a scale overflows an int.
 */
//@ immutable pure non_null_by_default
public class BigDecimal extends Number implements Comparable<BigDecimal> {
    //-RAC@ model public \bigint _unscaled;
    //-RAC@ model public int _scale;
    //-RAC@ model public \real value;

    //-RAC@ public invariant _scale >= 0 ? value * pow10(_scale) == _unscaled : value == _unscaled * pow10(-_scale);

    //@ public normal_behavior
    //@   requires n >= 0;
    //@   ensures \result == (n == 0 ? 1 : 10 * pow10(n-1));
    //@ model public static no_state helper \bigint pow10(int n);

    public static final BigDecimal ZERO;
    public static final BigDecimal ONE;
    public static final BigDecimal TWO;
    public static final BigDecimal TEN;

    //@ public normal_behavior
    //@   ensures ZERO != null && ONE != null && TWO != null && TEN != null;
    //-RAC@   ensures ZERO != null && ZERO._unscaled == 0 && ZERO._scale == 0 && ZERO.value == 0;
    //-RAC@   ensures ONE != null && ONE._unscaled == 1 && ONE._scale == 0 && ONE.value == 1;
    //-RAC@   ensures TWO != null && TWO._unscaled == 2 && TWO._scale == 0 && TWO.value == 2;
    //-RAC@   ensures TEN != null && TEN._unscaled == 10 && TEN._scale == 0 && TEN.value == 10;
    //@ static_initializer

    public static final int ROUND_UP;
    public static final int ROUND_DOWN;
    public static final int ROUND_CEILING;
    public static final int ROUND_FLOOR;
    public static final int ROUND_HALF_UP;
    public static final int ROUND_HALF_DOWN;
    public static final int ROUND_HALF_EVEN;
    public static final int ROUND_UNNECESSARY;

    // Constructors

    //@ public behavior
    //@   signals_only NumberFormatException;
    public BigDecimal(String val);

    // The exact value of the double; NaN and infinities throw
    //@ public normal_behavior
    //@   requires Double.isFinite(val);
    //-RAC@   ensures this.value == val;
    //@ also public exceptional_behavior
    //@   requires !Double.isFinite(val);
    //@   signals_only NumberFormatException;
    public BigDecimal(double val);

    //@ public normal_behavior
    //-RAC@   ensures _unscaled == val.value && _scale == 0;
    public BigDecimal(BigInteger val);

    //@ public normal_behavior
    //-RAC@   ensures _unscaled == unscaledVal.value && _scale == scale;
    public BigDecimal(BigInteger unscaledVal, int scale);

    //@ public normal_behavior
    //-RAC@   ensures _unscaled == val && _scale == 0;
    public BigDecimal(int val);

    //@ public normal_behavior
    //-RAC@   ensures _unscaled == val && _scale == 0;
    public BigDecimal(long val);

    // Static factories

    //@ public normal_behavior
    //-RAC@   ensures \result._unscaled == unscaledVal && \result._scale == scale;
    public static BigDecimal valueOf(long unscaledVal, int scale);

    //@ public normal_behavior
    //-RAC@   ensures \result._unscaled == val && \result._scale == 0;
    public static BigDecimal valueOf(long val);

    // The value of Double.toString(val), which need not be the exact value of the double
    //@ public normal_behavior
    //@   requires Double.isFinite(val);
    //@ also public exceptional_behavior
    //@   requires !Double.isFinite(val);
    //@   signals_only NumberFormatException;
    public static BigDecimal valueOf(double val);

    // Exact arithmetic

    //@ public normal_behavior
    //-RAC@   ensures \result.value == this.value + augend.value;
    //-RAC@   ensures \result._scale == (this._scale >= augend._scale ? this._scale : augend._scale);
    //-RAC@   ensures \result._unscaled == (this._scale >= augend._scale
    //-RAC@                   ? this._unscaled + augend._unscaled * pow10(this._scale - augend._scale)
    //-RAC@                   : this._unscaled * pow10(augend._scale - this._scale) + augend._unscaled);
    public BigDecimal add(BigDecimal augend);

    //@ public normal_behavior
    //-RAC@   ensures \result.value == this.value - subtrahend.value;
    //-RAC@   ensures \result._scale == (this._scale >= subtrahend._scale ? this._scale : subtrahend._scale);
    //-RAC@   ensures \result._unscaled == (this._scale >= subtrahend._scale
    //-RAC@                   ? this._unscaled - subtrahend._unscaled * pow10(this._scale - subtrahend._scale)
    //-RAC@                   : this._unscaled * pow10(subtrahend._scale - this._scale) - subtrahend._unscaled);
    public BigDecimal subtract(BigDecimal subtrahend);

    //@ public normal_behavior
    //-RAC@   ensures \result.value == this.value * multiplicand.value;
    //-RAC@   ensures \result._unscaled == this._unscaled * multiplicand._unscaled;
    //-RAC@   ensures \result._scale == this._scale + multiplicand._scale;
    public BigDecimal multiply(BigDecimal multiplicand);

    // Throws if the divisor is zero or the exact quotient has a nonterminating decimal expansion;
    // the second condition is not stated, so a normal result is not promised
    //@ public behavior
    //@   requires divisor.signum() != 0;
    //-RAC@   ensures \result.value * divisor.value == this.value;
    //@   signals_only ArithmeticException;
    //@ also public exceptional_behavior
    //@   requires divisor.signum() == 0;
    //@   signals_only ArithmeticException;
    public BigDecimal divide(BigDecimal divisor);

    // The quotient rounded to the given scale: within one unit in the last place of the exact quotient
    //@ public behavior
    //@   requires divisor.signum() != 0;
    //-RAC@   ensures \result._scale == scale;
    //-RAC@   ensures scale >= 0 ==> -1 < (\result.value - this.value / divisor.value) * pow10(scale) && (\result.value - this.value / divisor.value) * pow10(scale) < 1;
    //@   signals_only ArithmeticException;
    //@   signals (ArithmeticException) roundingMode == RoundingMode.UNNECESSARY;
    //@ also public exceptional_behavior
    //@   requires divisor.signum() == 0;
    //@   signals_only ArithmeticException;
    public BigDecimal divide(BigDecimal divisor, int scale, RoundingMode roundingMode);

    //@ public behavior
    //@   requires divisor.signum() != 0;
    //-RAC@   ensures \result._scale == this._scale;
    //-RAC@   ensures this._scale >= 0 ==> -1 < (\result.value - this.value / divisor.value) * pow10(this._scale) && (\result.value - this.value / divisor.value) * pow10(this._scale) < 1;
    //@   signals_only ArithmeticException;
    //@   signals (ArithmeticException) roundingMode == RoundingMode.UNNECESSARY;
    //@ also public exceptional_behavior
    //@   requires divisor.signum() == 0;
    //@   signals_only ArithmeticException;
    public BigDecimal divide(BigDecimal divisor, RoundingMode roundingMode);

    // The integer part of the exact quotient, truncated toward zero
    //@ public normal_behavior
    //@   requires divisor.signum() != 0;
    //-RAC@   ensures this._scale >= divisor._scale ==> \result._scale == this._scale - divisor._scale;
    //-RAC@   ensures \result._scale <= 0 || \result._unscaled % pow10(\result._scale) == 0;
    //-RAC@   ensures this.value >= 0 && divisor.value > 0 ==> \result.value * divisor.value <= this.value && this.value < (\result.value + 1) * divisor.value;
    //-RAC@   ensures this.value >= 0 && divisor.value < 0 ==> \result.value * divisor.value <= this.value && this.value < (\result.value - 1) * divisor.value;
    //-RAC@   ensures this.value < 0 && divisor.value > 0 ==> (\result.value - 1) * divisor.value < this.value && this.value <= \result.value * divisor.value;
    //-RAC@   ensures this.value < 0 && divisor.value < 0 ==> (\result.value + 1) * divisor.value < this.value && this.value <= \result.value * divisor.value;
    //@ also public exceptional_behavior
    //@   requires divisor.signum() == 0;
    //@   signals_only ArithmeticException;
    //@ spec_pure
    public BigDecimal divideToIntegralValue(BigDecimal divisor);

    //@ public normal_behavior
    //@   requires divisor.signum() != 0;
    //-RAC@   ensures this._scale >= divisor._scale ==> \result._scale == this._scale;
    //-RAC@   ensures \result.value == this.value - this.divideToIntegralValue(divisor).value * divisor.value;
    //@ also public exceptional_behavior
    //@   requires divisor.signum() == 0;
    //@   signals_only ArithmeticException;
    //@ spec_pure
    public BigDecimal remainder(BigDecimal divisor);

    //@ public normal_behavior
    //@   requires divisor.signum() != 0;
    //@   ensures \result.length == 2;
    //-RAC@   ensures \fresh(\result);
    //-RAC@   ensures \result[0].value == this.divideToIntegralValue(divisor).value;
    //-RAC@   ensures \result[1].value == this.remainder(divisor).value;
    //@ also public exceptional_behavior
    //@   requires divisor.signum() == 0;
    //@   signals_only ArithmeticException;
    public BigDecimal[] divideAndRemainder(BigDecimal divisor);

    //@ public normal_behavior
    //@   requires 0 <= n && n <= 999999999;
    //-RAC@   ensures \result._unscaled == BigInteger.ipow(this._unscaled, n);
    //-RAC@   ensures \result._scale == this._scale * n;
    //@ also public exceptional_behavior
    //@   requires !(0 <= n && n <= 999999999);
    //@   signals_only ArithmeticException;
    public BigDecimal pow(int n);

    //@ public normal_behavior
    //-RAC@   ensures \result._unscaled == (this._unscaled >= 0 ? this._unscaled : -this._unscaled);
    //-RAC@   ensures \result._scale == this._scale;
    //@   ensures signum() >= 0 ==> \result == this;
    public BigDecimal abs();

    //@ public normal_behavior
    //-RAC@   ensures \result._unscaled == -this._unscaled && \result._scale == this._scale;
    public BigDecimal negate();

    //@ public normal_behavior
    //@   ensures \result == this;
    public BigDecimal plus();

    // Accessors

    //@ public normal_behavior
    //-RAC@   ensures \result == (_unscaled > 0 ? 1 : _unscaled < 0 ? -1 : 0);
    //@   ensures -1 <= \result <= 1;
    //@ spec_pure helper
    public int signum();

    //@ public normal_behavior
    //-RAC@   ensures \result == _scale;
    //@ spec_pure helper
    public int scale();

    // The number of decimal digits in the unscaled value (1 for zero)
    //@ public normal_behavior
    //@   ensures \result >= 1;
    //-RAC@   ensures _unscaled < pow10(\result) && -_unscaled < pow10(\result);
    //-RAC@   ensures \result == 1 || pow10(\result - 1) <= _unscaled || pow10(\result - 1) <= -_unscaled;
    //@ spec_pure
    public int precision();

    //@ public normal_behavior
    //-RAC@   ensures \result.value == _unscaled;
    //@ spec_pure
    public BigInteger unscaledValue();

    // Scale changes

    //@ public normal_behavior
    //@   requires newScale >= scale();
    //-RAC@   ensures \result._scale == newScale && \result.value == this.value;
    //-RAC@   ensures \result._unscaled == this._unscaled * pow10(newScale - this._scale);
    //@ also public behavior
    //@   requires newScale < scale();
    //-RAC@   ensures \result._scale == newScale;
    //-RAC@   ensures -1 < (\result.value - this.value) * pow10(newScale) && (\result.value - this.value) * pow10(newScale) < 1;
    //-RAC@   ensures roundingMode == RoundingMode.DOWN ==> \result._unscaled == this._unscaled / pow10(this._scale - newScale);
    //@   signals_only ArithmeticException;
    //-RAC@   signals (ArithmeticException) roundingMode == RoundingMode.UNNECESSARY && this._unscaled % pow10(this._scale - newScale) != 0;
    //-RAC@   ensures roundingMode == RoundingMode.UNNECESSARY ==> this._unscaled % pow10(this._scale - newScale) == 0;
    public BigDecimal setScale(int newScale, RoundingMode roundingMode);

    // Same as setScale(newScale, RoundingMode.UNNECESSARY)
    //@ public normal_behavior
    //@   requires newScale >= scale();
    //-RAC@   ensures \result._scale == newScale && \result.value == this.value;
    //-RAC@   ensures \result._unscaled == this._unscaled * pow10(newScale - this._scale);
    //@ also public behavior
    //@   requires newScale < scale();
    //-RAC@   ensures \result._scale == newScale && \result.value == this.value;
    //-RAC@   ensures this._unscaled % pow10(this._scale - newScale) == 0;
    //-RAC@   ensures \result._unscaled == this._unscaled / pow10(this._scale - newScale);
    //@   signals_only ArithmeticException;
    //-RAC@   signals (ArithmeticException) this._unscaled % pow10(this._scale - newScale) != 0;
    public BigDecimal setScale(int newScale);

    //@ public normal_behavior
    //-RAC@   ensures \result._unscaled == this._unscaled && \result._scale == this._scale - n;
    public BigDecimal scaleByPowerOfTen(int n);

    // The value divided by 10^n, with scale max(scale + n, 0)
    //@ public normal_behavior
    //-RAC@   ensures this._scale + n >= 0 ==> \result._unscaled == this._unscaled && \result._scale == this._scale + n;
    //-RAC@   ensures this._scale + n < 0 ==> \result._unscaled == this._unscaled * pow10(-(this._scale + n)) && \result._scale == 0;
    public BigDecimal movePointLeft(int n);

    // The value multiplied by 10^n, with scale max(scale - n, 0)
    //@ public normal_behavior
    //-RAC@   ensures this._scale - n >= 0 ==> \result._unscaled == this._unscaled && \result._scale == this._scale - n;
    //-RAC@   ensures this._scale - n < 0 ==> \result._unscaled == this._unscaled * pow10(n - this._scale) && \result._scale == 0;
    public BigDecimal movePointRight(int n);

    //@ public normal_behavior
    //-RAC@   ensures \result.value == this.value;
    //-RAC@   ensures this._unscaled == 0 ==> \result._scale == 0;
    //-RAC@   ensures this._unscaled != 0 ==> \result._unscaled % 10 != 0;
    public BigDecimal stripTrailingZeros();

    // Comparison: compareTo compares values; equals also compares scales

    //@ also public normal_behavior
    //-RAC@   ensures this.value < val.value <==> \result == -1;
    //-RAC@   ensures this.value == val.value <==> \result == 0;
    //-RAC@   ensures this.value > val.value <==> \result == 1;
    //@   ensures -1 <= \result <= 1;
    //@ spec_pure
    public int compareTo(BigDecimal val);

    //@ also public normal_behavior
    //@   requires x instanceof BigDecimal;
    //-RAC@   ensures \result == (this._unscaled == ((BigDecimal)x)._unscaled && this._scale == ((BigDecimal)x)._scale);
    //@ also public normal_behavior
    //@   requires !(x instanceof BigDecimal);
    //@   ensures !\result;
    //@ spec_pure helper
    public boolean equals(/*@ nullable */ Object x);

    //@ public normal_behavior
    //-RAC@   ensures \result == (this.value <= val.value ? this : val);
    public BigDecimal min(BigDecimal val);

    //@ public normal_behavior
    //-RAC@   ensures \result == (this.value >= val.value ? this : val);
    public BigDecimal max(BigDecimal val);

    //@ also public normal_behavior
    //@   ensures true;
    public int hashCode();

    //@ also public normal_behavior
    //@   ensures true;
    public String toString();

    //@ public normal_behavior
    //@   ensures true;
    public String toEngineeringString();

    //@ public normal_behavior
    //@   ensures true;
    public String toPlainString();

    // Conversions

    // Truncates toward zero
    //@ public normal_behavior
    //-RAC@   ensures this._scale >= 0 ==> \result.value == this._unscaled / pow10(this._scale);
    //-RAC@   ensures this._scale < 0 ==> \result.value == this._unscaled * pow10(-this._scale);
    //@ spec_pure
    public BigInteger toBigInteger();

    //@ public behavior
    //-RAC@   ensures this._scale >= 0 ==> \result.value * pow10(this._scale) == this._unscaled;
    //-RAC@   ensures this._scale < 0 ==> \result.value == this._unscaled * pow10(-this._scale);
    //@   signals_only ArithmeticException;
    //-RAC@   signals (ArithmeticException) this._scale > 0 && this._unscaled % pow10(this._scale) != 0;
    public BigInteger toBigIntegerExact();

    //@ also public normal_behavior
    //-RAC@   requires Long.MIN_VALUE <= this.toBigInteger().value <= Long.MAX_VALUE;
    //-RAC@   ensures \result == this.toBigInteger().value;
    //@ spec_pure
    public long longValue();

    //@ also public normal_behavior
    //-RAC@   requires Integer.MIN_VALUE <= this.toBigInteger().value <= Integer.MAX_VALUE;
    //-RAC@   ensures \result == this.toBigInteger().value;
    //@ spec_pure
    public int intValue();

    //@ public behavior
    //-RAC@   ensures \result == this.value;
    //@   signals_only ArithmeticException;
    //-RAC@   signals (ArithmeticException) this.toBigInteger().value != this.value || !(Long.MIN_VALUE <= this.value <= Long.MAX_VALUE);
    //@ spec_pure
    public long longValueExact();

    //@ public behavior
    //-RAC@   ensures \result == this.value;
    //@   signals_only ArithmeticException;
    //-RAC@   signals (ArithmeticException) this.toBigInteger().value != this.value || !(Integer.MIN_VALUE <= this.value <= Integer.MAX_VALUE);
    //@ spec_pure
    public int intValueExact();

    //@ public behavior
    //-RAC@   ensures \result == this.value;
    //@   signals_only ArithmeticException;
    //-RAC@   signals (ArithmeticException) this.toBigInteger().value != this.value || !(Short.MIN_VALUE <= this.value <= Short.MAX_VALUE);
    //@ spec_pure
    public short shortValueExact();

    //@ public behavior
    //-RAC@   ensures \result == this.value;
    //@   signals_only ArithmeticException;
    //-RAC@   signals (ArithmeticException) this.toBigInteger().value != this.value || !(Byte.MIN_VALUE <= this.value <= Byte.MAX_VALUE);
    //@ spec_pure
    public byte byteValueExact();

    //@ also public normal_behavior
    //@   ensures true;
    //@ spec_pure
    public float floatValue();

    //@ also public normal_behavior
    //@   ensures true;
    //@ spec_pure
    public double doubleValue();

    // One unit in the last place: 1 with this scale
    //@ public normal_behavior
    //-RAC@   ensures \result._unscaled == 1 && \result._scale == this._scale;
    public BigDecimal ulp();
}
