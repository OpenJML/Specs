package java.math;

// The JDK fixes the legacy BigDecimal.ROUND_* constants at 0..7 and declares the constants in the same order,
// so valueOf(rm).ordinal() == rm.
//@ non_null_by_default
public enum RoundingMode {
    UP(0),
    DOWN(1),
    CEILING(2),
    FLOOR(3),
    HALF_UP(4),
    HALF_DOWN(5),
    HALF_EVEN(6),
    UNNECESSARY(7);

    private RoundingMode(int oldMode);

    //@ public normal_behavior
    //@   requires rm == 0;
    //@   ensures \result == UP;
    //@ also public normal_behavior
    //@   requires rm == 1;
    //@   ensures \result == DOWN;
    //@ also public normal_behavior
    //@   requires rm == 2;
    //@   ensures \result == CEILING;
    //@ also public normal_behavior
    //@   requires rm == 3;
    //@   ensures \result == FLOOR;
    //@ also public normal_behavior
    //@   requires rm == 4;
    //@   ensures \result == HALF_UP;
    //@ also public normal_behavior
    //@   requires rm == 5;
    //@   ensures \result == HALF_DOWN;
    //@ also public normal_behavior
    //@   requires rm == 6;
    //@   ensures \result == HALF_EVEN;
    //@ also public normal_behavior
    //@   requires rm == 7;
    //@   ensures \result == UNNECESSARY;
    //@ also public exceptional_behavior
    //@   requires rm < 0 || rm > 7;
    //@   signals_only IllegalArgumentException;
    //@ spec_pure
    public static RoundingMode valueOf(int rm);
}
