    //@   signals_only NullPointerException;
    //@ pure
    public BigInteger modPow(BigInteger exponent, BigInteger m);

    static int[] bnExpModThreshTable;

    static int mulAdd(int[] out, int[] in, int offset, int len, int k);

    static int addOne(int[] a, int offset, int mlen, int carry);

    // Non-invertibility is not specified, so a normal result is not promised
    //@ public behavior
    //@   requires m != null && m.signum() > 0;
    //@   ensures \result != null;
    //-RAC@   ensures 0 <= \result.value && \result.value < m.value;
    //-RAC@   ensures m.value == 1 ? \result.value == 0 : (this.value * \result.value - 1) % m.value == 0;
    //@   signals_only ArithmeticException;
    //@ also public exceptional_behavior
    //@   requires m != null && m.signum() <= 0;
    //@   signals_only ArithmeticException;
    //@ also public exceptional_behavior
    //@   requires m == null;
    //@   signals_only NullPointerException;
    //@ pure
    public BigInteger modInverse(BigInteger m);

    // Shift Operations

    //@ public normal_behavior
    //@   ensures \result != null;
    //-RAC@   ensures n >= 0 ==> \result.value == this.value * pow2(n);
    //-RAC@   ensures n < 0 && n != Integer.MIN_VALUE ==> \result.value * pow2(-n) <= this.value && this.value < (\result.value + 1) * pow2(-n);
    public BigInteger shiftLeft(int n);

    // A floor division: rounds toward negative infinity
    //@ public normal_behavior
    //@   ensures \result != null;
    //-RAC@   ensures n >= 0 ==> \result.value * pow2(n) <= this.value && this.value < (\result.value + 1) * pow2(n);
    //-RAC@   ensures n < 0 && n != Integer.MIN_VALUE ==> \result.value == this.value * pow2(-n);
    //@ spec_pure
    public BigInteger shiftRight(int n);

    int[] javaIncrement(int[] val);

    // Bitwise Operations: the bits are those of the two's-complement representation, extended indefinitely

    //@ public normal_behavior
    //@   requires val != null;
    //@   ensures \result != null;
    //@   ensures (\forall int i; 0 <= i; \result.testBit(i) == (this.testBit(i) && val.testBit(i)));
    //-RAC@   ensures \result.value < 0 <==> (this.value < 0 && val.value < 0);
    //@ also public exceptional_behavior
    //@   requires val == null;
    //@   signals_only NullPointerException;
    //@ pure
    public BigInteger and(BigInteger val);

    //@ public normal_behavior
    //@   requires val != null;
    //@   ensures \result != null;
    //@   ensures (\forall int i; 0 <= i; \result.testBit(i) == (this.testBit(i) || val.testBit(i)));
    //-RAC@   ensures \result.value < 0 <==> (this.value < 0 || val.value < 0);
    //@ also public exceptional_behavior
    //@   requires val == null;
    //@   signals_only NullPointerException;
    //@ pure
    public BigInteger or(BigInteger val);

    //@ public normal_behavior
    //@   requires val != null;
    //@   ensures \result != null;
    //@   ensures (\forall int i; 0 <= i; \result.testBit(i) == (this.testBit(i) != val.testBit(i)));
    //-RAC@   ensures \result.value < 0 <==> ((this.value < 0) != (val.value < 0));
    //@ also public exceptional_behavior
    //@   requires val == null;
    //@   signals_only NullPointerException;
    //@ pure
    public BigInteger xor(BigInteger val);

    //@ public normal_behavior
    //@   ensures \result != null;
    //-RAC@   ensures \result.value == -this.value - 1;
    //@ pure
    public BigInteger not();

    //@ public normal_behavior
    //@   requires val != null;
    //@   ensures \result != null;
    //@   ensures (\forall int i; 0 <= i; \result.testBit(i) == (this.testBit(i) && !val.testBit(i)));
    //-RAC@   ensures \result.value < 0 <==> (this.value < 0 && val.value >= 0);
    //@ also public exceptional_behavior
    //@   requires val == null;
    //@   signals_only NullPointerException;
    //@ pure
    public BigInteger andNot(BigInteger val);

    // Single Bit Operations

    //@ public normal_behavior
    //@   requires n >= 0;
    //-RAC@   ensures \result == (this.shiftRight(n).value % 2 != 0);
    //@ also public exceptional_behavior
    //@   requires n < 0;
    //@   signals_only ArithmeticException;
    //@ spec_pure
    public boolean testBit(int n);

    //@ public normal_behavior
    //@   requires n >= 0;
    //@   ensures \result != null;
    //-RAC@   ensures \result.value == (this.testBit(n) ? this.value : this.value + pow2(n));
    //@ also public exceptional_behavior
    //@   requires n < 0;
    //@   signals_only ArithmeticException;
    public BigInteger setBit(int n);

    //@ public normal_behavior
    //@   requires n >= 0;
    //@   ensures \result != null;
    //-RAC@   ensures \result.value == (this.testBit(n) ? this.value - pow2(n) : this.value);
    //@ also public exceptional_behavior
    //@   requires n < 0;
    //@   signals_only ArithmeticException;
    public BigInteger clearBit(int n);

    //@ public normal_behavior
    //@   requires n >= 0;
    //@   ensures \result != null;
    //-RAC@   ensures \result.value == (this.testBit(n) ? this.value - pow2(n) : this.value + pow2(n));
    //@ also public exceptional_behavior
    //@   requires n < 0;
    //@   signals_only ArithmeticException;
    public BigInteger flipBit(int n);

    //@ public normal_behavior
    //-RAC@   ensures value == 0 <==> \result == -1;
    //-RAC@   ensures value != 0 ==> \result >= 0 && value % pow2(\result) == 0 && value % pow2(\result + 1) != 0;
    //@   ensures \result >= -1;
    //@ spec_pure
    public int getLowestSetBit();

    // Miscellaneous Bit Operations

    // The number of bits in the minimal two's-complement representation, excluding a sign bit
    //@ public normal_behavior
    //-RAC@   ensures value == 0 ==> \result == 0;
    //-RAC@   ensures value != 0 && value != -1 ==> \result > 0;
    //-RAC@   ensures value >= 0 ==> value < pow2(\result) && (\result == 0 || pow2(\result - 1) <= value);
    //-RAC@   ensures value < 0 ==> -pow2(\result) <= value && (\result == 0 || value < -pow2(\result - 1));
    //@   ensures \result >= 0;
    //@ spec_pure
    public int bitLength();

    // static int bitLen(int w);   package-level method removed from specification (dmz, 2009-11-17)

    // static final byte[] trailingZeroTable;   package-level array removed from specification (dmz, 2009-11-17)

    // The number of bits that differ from the sign bit
    //@ public normal_behavior
    //-RAC@   ensures value == 0 ==> \result == 0;
    //-RAC@   ensures value == -1 ==> \result == 0;
    //-RAC@   ensures value > 0 ==> \result > 0;
    //@   ensures \result >= 0;
    //@ spec_pure
    public int bitCount();

    // static int bitCnt(int val);   package-level method removed from specification (dmz, 2009-11-17)

    // static int trailingZeroCnt(int val);   package-level method removed from specification (dmz, 2009-11-17)

