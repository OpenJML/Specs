    //@   signals_only IllegalArgumentException;
    //@ pure
    public BigInteger(int numBits, Random rnd);

    //@ public normal_behavior
    //@   requires bitLength >= 2 && rnd != null;
    //-RAC@   ensures value > 0;
    //@   ensures this.bitLength() == bitLength;
    //@ also public exceptional_behavior
    //@   requires bitLength < 2;
    //@   signals_only ArithmeticException;
    //@ pure
    public BigInteger(int bitLength, int certainty, Random rnd);

    //@ public normal_behavior
    //@   requires bitLength >= 2 && rnd != null;
    //@   ensures \result != null;
    //-RAC@   ensures \result.value > 0;
    //@   ensures \result.bitLength() == bitLength;
    //@ also public exceptional_behavior
    //@   requires bitLength < 2;
    //@   signals_only ArithmeticException;
    public static /*@ pure @*/ BigInteger probablePrime(int bitLength, Random rnd);

    //@ public normal_behavior
    //@   requires signum() >= 0;
    //@   ensures \result != null;
    //-RAC@   ensures \result.value > value;
    //@ also public exceptional_behavior
    //@   requires signum() < 0;
    //@   signals_only ArithmeticException;
    public BigInteger nextProbablePrime();

    boolean primeToCertainty(int certainty, java.util.Random random); // CHANGED in 1.6

    private static int jacobiSymbol(int p, BigInteger n);

    //Static Factory Methods

    //@ public normal_behavior
    //@   ensures \result != null;
    //-RAC@   ensures \result.value == val;
    public static /*@ pure helper @*/ BigInteger valueOf(long val);

    public static final BigInteger ZERO;
    public static final BigInteger ONE;
    public static final BigInteger TWO;
    public static final BigInteger TEN;

    //@ public normal_behavior
    //@   ensures ZERO != null && ONE != null && TWO != null && TEN != null;
    //-RAC@   ensures ZERO != null && ZERO.value == 0;
    //-RAC@   ensures ONE != null && ONE.value == 1;
    //-RAC@   ensures TWO != null && TWO.value == 2;
    //-RAC@   ensures TEN != null && TEN.value == 10;
    //@ static_initializer

    // Arithmetic Operations

    //@ public normal_behavior
    //@   requires val != null;
    //@   ensures \result != null;
    //-RAC@   ensures \result.value == this.value + val.value;
    public BigInteger add(BigInteger val);

    //@ public normal_behavior
    //@   requires val != null;
    //@   ensures \result != null;
    //-RAC@   ensures \result.value == this.value - val.value;
    public BigInteger subtract(BigInteger val);

    //@ public normal_behavior
    //@   requires val != null;
    //@   ensures \result != null;
    //-RAC@   ensures \result.value == this.value * val.value;
    public BigInteger multiply(BigInteger val);

    //@ public normal_behavior
    //@   requires val != null;
    //@   ensures \result != null;
    //-RAC@   ensures \result.value == this.value * val.value;
    public BigInteger parallelMultiply(BigInteger val);

    // Division truncates toward zero, as does / on \bigint
    //@ public normal_behavior
    //@   requires val != null;
    //@   requires val.signum() != 0;
    //@   ensures \result != null;
    //-RAC@   ensures \result.value == this.value / val.value;
    //@ also public exceptional_behavior
    //@   requires val != null;
    //@   requires val.signum() == 0;
    //@   signals_only ArithmeticException;
    public BigInteger divide(BigInteger val);

    //@ public normal_behavior
    //@   requires val != null;
    //@   requires val.signum() != 0;
    //@   ensures \result != null && \result.length == 2 && \result[0] != null && \result[1] != null;
    //-RAC@   ensures \fresh(\result);
    //-RAC@   ensures \result[0].value == this.value / val.value;
    //-RAC@   ensures \result[1].value == this.value % val.value;
    //@ also public exceptional_behavior
    //@   requires val != null;
    //@   requires val.signum() == 0;
    //@   signals_only ArithmeticException;
    public BigInteger[] divideAndRemainder(BigInteger val);

    //@ public normal_behavior
    //@   requires val != null;
    //@   requires val.signum() != 0;
    //@   ensures \result != null;
    //-RAC@   ensures \result.value == this.value % val.value;
    //@ also public exceptional_behavior
    //@   requires val != null;
    //@   requires val.signum() == 0;
    //@   signals_only ArithmeticException;
    public BigInteger remainder(BigInteger val);

    //@ public normal_behavior
    //@   requires exponent >= 0;
    //@   ensures \result != null;
    //-RAC@   ensures \result.value == ipow(this.value, exponent);
    //@ also public exceptional_behavior
    //@   requires exponent < 0;
    //@   signals_only ArithmeticException;
    public BigInteger pow(int exponent);

    //@ public normal_behavior
    //@   requires signum() >= 0;
    //@   ensures \result != null;
    //-RAC@   ensures \result.value >= 0;
    //-RAC@   ensures \result.value * \result.value <= this.value;
    //-RAC@   ensures this.value < (\result.value + 1) * (\result.value + 1);
    //@ also public exceptional_behavior
    //@   requires signum() < 0;
    //@   signals_only ArithmeticException;
    public BigInteger sqrt();

    //@ public normal_behavior
    //@   requires signum() >= 0;
    //@   ensures \result != null && \result.length == 2 && \result[0] != null && \result[1] != null;
    //-RAC@   ensures \fresh(\result);
    //-RAC@   ensures \result[0].value >= 0;
    //-RAC@   ensures \result[0].value * \result[0].value <= this.value;
    //-RAC@   ensures this.value < (\result[0].value + 1) * (\result[0].value + 1);
    //-RAC@   ensures \result[1].value == this.value - \result[0].value * \result[0].value;
    //@ also public exceptional_behavior
    //@   requires signum() < 0;
    //@   signals_only ArithmeticException;
    public BigInteger[] sqrtAndRemainder();

    // The result is a common divisor; that it is the greatest is not stated
    //@ public normal_behavior
    //@   requires val != null;
    //@   ensures \result != null;
    //-RAC@   ensures \result.value >= 0;
    //-RAC@   ensures \result.value == 0 <==> (this.value == 0 && val.value == 0);
    //-RAC@   ensures \result.value != 0 ==> (this.value % \result.value == 0 && val.value % \result.value == 0);
    //-RAC@   ensures this.value == 0 ==> \result.value == (val.value >= 0 ? val.value : -val.value);
    //-RAC@   ensures val.value == 0 ==> \result.value == (this.value >= 0 ? this.value : -this.value);
    public BigInteger gcd(BigInteger val);

    static void primitiveRightShift(int[] a, int len, int n);

    static void primitiveLeftShift(int[] a, int len, int n);

    //@ public normal_behavior
    //@   ensures \result != null;
    //@   ensures signum() >= 0 ==> \result == this;
    //-RAC@ ensures \result.value == (this.value >= 0 ? this.value : -this.value);
    public BigInteger abs();

    //@ public normal_behavior
    //@   ensures \result != null;
    //-RAC@ ensures \result.value == - this.value;
    //@ pure
    public BigInteger negate();

    //@ public normal_behavior
    //-RAC@   ensures \result == (value > 0 ? 1 : value < 0 ? -1: 0);
    //@   ensures -1 <= \result <= 1;
    //@ pure helper
    public int signum();

    // Modular Arithmetic Operations

    //@ public normal_behavior
    //@   requires m != null && m.signum() > 0;
    //@   ensures \result != null;
