    //@ pure
    public BigInteger mod(BigInteger m);

    // Exponentiation by a negative exponent, which needs an inverse, is not specified
    //@ public normal_behavior
    //@   requires m != null & exponent != null;
    //@   requires m.signum() > 0 && exponent.signum() >= 0;
