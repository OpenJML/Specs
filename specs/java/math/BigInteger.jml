    //@   requires !(0 <= off && 0 <= len && off + len <= val.length);
    //@   signals_only IndexOutOfBoundsException;
    //@ pure
    public BigInteger(byte[] val, int off, int len);

    //@ public normal_behavior
    //@    requires magnitude != null;
    //@    requires signum == 1 || signum == -1;
