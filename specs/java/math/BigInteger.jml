    //@    public normal_behavior
    //@       requires certainty > 0;
    //-RAC@   ensures \result == isProbablePrime(value,certainty);
    //-RAC@   ensures value <= 1 ==> !\result;
    //@ also public normal_behavior
    //@       requires certainty <= 0;
    //@       ensures \result;
    //@ spec_pure
    public boolean isProbablePrime(int certainty);

    //@ public normal_behavior
    //@   requires certainty > 0;
    //@ no_state
    //@ model public static boolean isProbablePrime(\bigint v, int certainty);

    // Comparison Operations

    //@ also public normal_behavior
    //@   requires val != null;
    //-RAC@   ensures this.value < val.value <==> \result == -1;
    //-RAC@   ensures this.value == val.value <==> \result == 0;
    //-RAC@   ensures this.value > val.value <==> \result == 1;
    //@   ensures -1 <= \result <= 1;
    //@ spec_pure
    public int compareTo(BigInteger val);

    //@ also public normal_behavior
    //@   requires x != null && x instanceof BigInteger;
    //-RAC@   ensures \result == (this.value == ((BigInteger)x).value);
    //@ also
    //@   requires !(x != null && x instanceof BigInteger);
    //@   ensures \result == false;
    public /*@ spec_pure helper @*/ boolean equals(/*@ nullable */ Object x);

    //@ public normal_behavior
    //@   requires val != null;
    //@   ensures \result != null;
    //-RAC@   ensures \result.value == (this.value <= val.value ? this.value : val.value);
    //@ also public exceptional_behavior
    //@   requires val == null;
    //@   signals_only NullPointerException;
    //@ pure
    public BigInteger min(BigInteger val);

    //@ public normal_behavior
    //@   requires val != null;
    //@   ensures \result != null;
    //-RAC@   ensures \result.value == (this.value >= val.value ? this.value : val.value);
    //@ also public exceptional_behavior
    //@   requires val == null;
    //@   signals_only NullPointerException;
    //@ pure
    public BigInteger max(BigInteger val);

    // Hash Function

    //@ also public normal_behavior
    //@   ensures true;
    public int hashCode();

    //@ public normal_behavior
    //@   ensures \result != null;
    //-RAC@ ensures Character.MIN_RADIX <= radix <= Character.MAX_RADIX ==> parse(\result,radix) == this.value;
    //-RAC@ ensures !(Character.MIN_RADIX <= radix <= Character.MAX_RADIX) ==> parse(\result,10) == this.value;
    public String toString(int radix);

    //@ also public normal_behavior
    //@   ensures \result != null;
    //-RAC@ ensures parse(\result,10) == this.value;
    public String toString();

    //@ public normal_behavior
    //@   ensures \result == (n <= 0 ? 1 : 256 * pow256(n-1));
    //@ model public static no_state helper \bigint pow256(\bigint n);

    // @ axiom (\forall \bigint n; n >= 0 ==> pow256(n+1) > pow256(n)); // FIXME - this axiom causes infeasibility (cf. gitbug578)
    // @ axiom (\forall \bigint m, n; m > n && n >= 0; pow256(m) > pow256(n)); // FIXME - this axiom causes infeasibility (cf. gitbug578)

    //@     public normal_behavior
    //@       requires this.signum() > 0;
    //@       ensures \result != null;
    //@       ensures \result.length > 0;
    //-RAC@   ensures convert(\result) == this.value;
    //-RAC@   ensures (pow256(\result.length-1)/2 <= this.value && this.value < pow256(\result.length-1)) ==> \result[0] == 0;
    //-RAC@   ensures (pow256(\result.length-1) <= this.value && this.value < pow256(\result.length)/2) ==> \result[0] != 0;
    //-RAC@   ensures (pow256(\result.length-1)/2 <= this.value && this.value < pow256(\result.length)/2);
    //@     also public normal_behavior
    //@       requires this.signum() < 0;
    //@       ensures \result != null;
    //@       ensures \result.length > 0;
    //@       ensures \result[0] < 0;
    //-RAC@   ensures convert(\result) == this.value;
    //-RAC@   ensures pow256(\result.length-1)/2 < -this.value && -this.value <= pow256(\result.length)/2;
    //@     also public normal_behavior
    //@       requires this.signum() == 0;
    //@       ensures \result != null;
    //@       ensures \result.length == 1;
    //@       ensures \result[0] == 0;
    //-RAC@   ensures convert(\result) == this.value;
    //@ pure helper
    public byte[] toByteArray();

    //-RAC@ also
    //-RAC@ requires Integer.MIN_VALUE <= this.value <= Integer.MAX_VALUE;
    //-RAC@ ensures \result == this.value;
    //@ spec_pure helper
    public int intValue();

    //-RAC@ also
    //-RAC@ requires Long.MIN_VALUE <= this.value <= Long.MAX_VALUE;
    //-RAC@ ensures \result == this.value;
    //@ spec_pure helper
    public long longValue();

    //@ also
    //@ ensures_redundantly this.equals(\old(this));
    //@ spec_pure helper
    public float floatValue();

    //@ also
    //@ ensures_redundantly this.equals(\old(this));
    //@ spec_pure helper
    public double doubleValue();

    //@ public normal_behavior
    //-RAC@   requires Long.MIN_VALUE <= this.value <= Long.MAX_VALUE;
    //+RAC@   requires bitLength() <= 63;
    //-RAC@   ensures \result == this.value;
    //@ also public exceptional_behavior
    //-RAC@   requires !(Long.MIN_VALUE <= this.value <= Long.MAX_VALUE);
    //+RAC@   requires !(bitLength() <= 63);
    //@   signals_only ArithmeticException;
    //@ spec_pure
    public long longValueExact();

    //@ public normal_behavior
    //-RAC@   requires Integer.MIN_VALUE <= this.value <= Integer.MAX_VALUE;
    //+RAC@   requires bitLength() <= 31;
    //-RAC@   ensures \result == this.value;
    //@ also public exceptional_behavior
    //-RAC@   requires !(Integer.MIN_VALUE <= this.value <= Integer.MAX_VALUE);
    //+RAC@   requires !(bitLength() <= 31);
    //@   signals_only ArithmeticException;
    //@ spec_pure
    public int intValueExact();

    //@ public normal_behavior
    //-RAC@   requires Short.MIN_VALUE <= this.value <= Short.MAX_VALUE;
    //+RAC@   requires bitLength() <= 31 && Short.MIN_VALUE <= intValue() && intValue() <= Short.MAX_VALUE;
    //-RAC@   ensures \result == this.value;
    //@ also public exceptional_behavior
    //-RAC@   requires !(Short.MIN_VALUE <= this.value <= Short.MAX_VALUE);
    //+RAC@   requires !(bitLength() <= 31 && Short.MIN_VALUE <= intValue() && intValue() <= Short.MAX_VALUE);
    //@   signals_only ArithmeticException;
    //@ spec_pure
    public short shortValueExact();

    //@ public normal_behavior
    //-RAC@   requires Byte.MIN_VALUE <= this.value <= Byte.MAX_VALUE;
    //+RAC@   requires bitLength() <= 31 && Byte.MIN_VALUE <= intValue() && intValue() <= Byte.MAX_VALUE;
    //-RAC@   ensures \result == this.value;
    //@ also public exceptional_behavior
    //-RAC@   requires !(Byte.MIN_VALUE <= this.value <= Byte.MAX_VALUE);
    //+RAC@   requires !(bitLength() <= 31 && Byte.MIN_VALUE <= intValue() && intValue() <= Byte.MAX_VALUE);
