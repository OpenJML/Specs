package java.time;

// An Instant is a whole number of nanoseconds from the epoch, getEpochSecond() * 10^9 + getNano(), with
// 0 <= getNano() < 10^9 and getEpochSecond() between Instant.MIN and Instant.MAX (-31557014167219200 and
// 31556889864403199). The specifications state results by that exact (\bigint) value. A result outside that range
// throws DateTimeException, or ArithmeticException where the implementation's long arithmetic overflows first.
// Not specified: now, from, parse, the TemporalAccessor and Temporal methods (isSupported, range, get, getLong, with,
// truncatedTo, plus/minus with a TemporalAmount or TemporalUnit, query, adjustInto, until), atOffset, atZone, toString.
//@ non_null_by_default
public final class Instant implements java.time.temporal.Temporal, java.time.temporal.TemporalAdjuster,
                                      Comparable<Instant>, java.io.Serializable {

    public static final Instant EPOCH;
    public static final Instant MIN;
    public static final Instant MAX;

    //@ spec_public
    private final long seconds; //-RAC@ in theHashCode;
    //@ spec_public
    private final int nanos; //-RAC@ in theHashCode;

    //-RAC@ public invariant 0 <= nanos && nanos < 1000000000;
    //-RAC@ public invariant -31557014167219200L <= seconds && seconds <= 31556889864403199L;

    //@ public normal_behavior
    //@   ensures EPOCH.getEpochSecond() == 0 && EPOCH.getNano() == 0;
    //@   ensures MIN.getEpochSecond() == -31557014167219200L && MIN.getNano() == 0;
    //@   ensures MAX.getEpochSecond() == 31556889864403199L && MAX.getNano() == 999999999;
    //@ static_initializer

    // Connects Object.hashCode's specification to this class's hashCode
    //-RAC@ public represents theHashCode = ((int) (seconds ^ (seconds >>> 32))) + (51 * nanos);

    //-RAC@ private normal_behavior
    //-RAC@   requires -31557014167219200L <= epochSecond && epochSecond <= 31556889864403199L && 0 <= nanos && nanos < 1000000000;
    //-RAC@   ensures this.seconds == epochSecond && this.nanos == nanos;
    //@ pure
    private Instant(long epochSecond, int nanos);

    //-RAC@ private normal_behavior
    //-RAC@   requires -31557014167219200L <= seconds && seconds <= 31556889864403199L && 0 <= nanoOfSecond && nanoOfSecond < 1000000000;
    //-RAC@   ensures \result.seconds == seconds && \result.nanos == nanoOfSecond;
    //-RAC@ also private exceptional_behavior
    //-RAC@   requires (seconds < -31557014167219200L || seconds > 31556889864403199L) && 0 <= nanoOfSecond && nanoOfSecond < 1000000000;
    //-RAC@   signals_only DateTimeException;
    //@ spec_pure
    private static Instant create(long seconds, int nanoOfSecond);


    //@ public normal_behavior
    //@   requires -31557014167219200L <= epochSecond && epochSecond <= 31556889864403199L;
    //@   ensures \result.getEpochSecond() == epochSecond && \result.getNano() == 0;
    //@ also public exceptional_behavior
    //@   requires epochSecond < -31557014167219200L || epochSecond > 31556889864403199L;
    //@   signals_only DateTimeException;
    //@ spec_pure
    public static Instant ofEpochSecond(long epochSecond);

    //@ public normal_behavior
    //@   requires (\bigint)-31557014167219200L * 1000000000 <= ((\bigint)epochSecond * 1000000000 + nanoAdjustment) && ((\bigint)epochSecond * 1000000000 + nanoAdjustment) <= (\bigint)31556889864403199L * 1000000000 + 999999999;
    //@   ensures ((\bigint)\result.getEpochSecond() * 1000000000 + \result.getNano()) == ((\bigint)epochSecond * 1000000000 + nanoAdjustment);
    //@ also public exceptional_behavior
    //@   requires !((\bigint)-31557014167219200L * 1000000000 <= ((\bigint)epochSecond * 1000000000 + nanoAdjustment) && ((\bigint)epochSecond * 1000000000 + nanoAdjustment) <= (\bigint)31556889864403199L * 1000000000 + 999999999);
    //@   signals_only DateTimeException, ArithmeticException;
    //@ spec_pure
    public static Instant ofEpochSecond(long epochSecond, long nanoAdjustment);

    // Every long number of milliseconds is within the Instant range
    //@ public normal_behavior
    //@   ensures ((\bigint)\result.getEpochSecond() * 1000000000 + \result.getNano()) == (\bigint)epochMilli * 1000000;
    //@ spec_pure
    public static Instant ofEpochMilli(long epochMilli);

    //@ public normal_behavior
    //-RAC@   ensures \result == seconds;
    //@ pure helper
    public long getEpochSecond();

    // 0 <= getNano() < 10^9, by the invariant
    //@ public normal_behavior
    //-RAC@   ensures \result == nanos;
    //@ pure helper
    public int getNano();

    //@ private normal_behavior
    //@   requires (\bigint)-31557014167219200L * 1000000000 <= ((\bigint)getEpochSecond() * 1000000000 + getNano()) + (\bigint)secondsToAdd * 1000000000 + nanosToAdd && ((\bigint)getEpochSecond() * 1000000000 + getNano()) + (\bigint)secondsToAdd * 1000000000 + nanosToAdd <= (\bigint)31556889864403199L * 1000000000 + 999999999;
    //@   ensures ((\bigint)\result.getEpochSecond() * 1000000000 + \result.getNano()) == ((\bigint)getEpochSecond() * 1000000000 + getNano()) + (\bigint)secondsToAdd * 1000000000 + nanosToAdd;
    //@ also private exceptional_behavior
    //@   requires !((\bigint)-31557014167219200L * 1000000000 <= ((\bigint)getEpochSecond() * 1000000000 + getNano()) + (\bigint)secondsToAdd * 1000000000 + nanosToAdd && ((\bigint)getEpochSecond() * 1000000000 + getNano()) + (\bigint)secondsToAdd * 1000000000 + nanosToAdd <= (\bigint)31556889864403199L * 1000000000 + 999999999);
    //@   signals_only DateTimeException, ArithmeticException;
    //@ spec_pure
    private Instant plus(long secondsToAdd, long nanosToAdd);

    //@ public normal_behavior
    //@   requires (\bigint)-31557014167219200L * 1000000000 <= ((\bigint)getEpochSecond() * 1000000000 + getNano()) + (\bigint)secondsToAdd * 1000000000 && ((\bigint)getEpochSecond() * 1000000000 + getNano()) + (\bigint)secondsToAdd * 1000000000 <= (\bigint)31556889864403199L * 1000000000 + 999999999;
    //@   ensures ((\bigint)\result.getEpochSecond() * 1000000000 + \result.getNano()) == ((\bigint)getEpochSecond() * 1000000000 + getNano()) + (\bigint)secondsToAdd * 1000000000;
    //@ also public exceptional_behavior
    //@   requires !((\bigint)-31557014167219200L * 1000000000 <= ((\bigint)getEpochSecond() * 1000000000 + getNano()) + (\bigint)secondsToAdd * 1000000000 && ((\bigint)getEpochSecond() * 1000000000 + getNano()) + (\bigint)secondsToAdd * 1000000000 <= (\bigint)31556889864403199L * 1000000000 + 999999999);
    //@   signals_only DateTimeException, ArithmeticException;
    //@ spec_pure
    public Instant plusSeconds(long secondsToAdd);

    //@ public normal_behavior
    //@   requires (\bigint)-31557014167219200L * 1000000000 <= ((\bigint)getEpochSecond() * 1000000000 + getNano()) + (\bigint)millisToAdd * 1000000 && ((\bigint)getEpochSecond() * 1000000000 + getNano()) + (\bigint)millisToAdd * 1000000 <= (\bigint)31556889864403199L * 1000000000 + 999999999;
    //@   ensures ((\bigint)\result.getEpochSecond() * 1000000000 + \result.getNano()) == ((\bigint)getEpochSecond() * 1000000000 + getNano()) + (\bigint)millisToAdd * 1000000;
    //@ also public exceptional_behavior
    //@   requires !((\bigint)-31557014167219200L * 1000000000 <= ((\bigint)getEpochSecond() * 1000000000 + getNano()) + (\bigint)millisToAdd * 1000000 && ((\bigint)getEpochSecond() * 1000000000 + getNano()) + (\bigint)millisToAdd * 1000000 <= (\bigint)31556889864403199L * 1000000000 + 999999999);
    //@   signals_only DateTimeException, ArithmeticException;
    //@ spec_pure
    public Instant plusMillis(long millisToAdd);

    //@ public normal_behavior
    //@   requires (\bigint)-31557014167219200L * 1000000000 <= ((\bigint)getEpochSecond() * 1000000000 + getNano()) + nanosToAdd && ((\bigint)getEpochSecond() * 1000000000 + getNano()) + nanosToAdd <= (\bigint)31556889864403199L * 1000000000 + 999999999;
    //@   ensures ((\bigint)\result.getEpochSecond() * 1000000000 + \result.getNano()) == ((\bigint)getEpochSecond() * 1000000000 + getNano()) + nanosToAdd;
    //@ also public exceptional_behavior
    //@   requires !((\bigint)-31557014167219200L * 1000000000 <= ((\bigint)getEpochSecond() * 1000000000 + getNano()) + nanosToAdd && ((\bigint)getEpochSecond() * 1000000000 + getNano()) + nanosToAdd <= (\bigint)31556889864403199L * 1000000000 + 999999999);
    //@   signals_only DateTimeException, ArithmeticException;
    //@ spec_pure
    public Instant plusNanos(long nanosToAdd);

    //@ public normal_behavior
    //@   requires (\bigint)-31557014167219200L * 1000000000 <= ((\bigint)getEpochSecond() * 1000000000 + getNano()) - (\bigint)secondsToSubtract * 1000000000 && ((\bigint)getEpochSecond() * 1000000000 + getNano()) - (\bigint)secondsToSubtract * 1000000000 <= (\bigint)31556889864403199L * 1000000000 + 999999999;
    //@   ensures ((\bigint)\result.getEpochSecond() * 1000000000 + \result.getNano()) == ((\bigint)getEpochSecond() * 1000000000 + getNano()) - (\bigint)secondsToSubtract * 1000000000;
    //@ also public exceptional_behavior
    //@   requires !((\bigint)-31557014167219200L * 1000000000 <= ((\bigint)getEpochSecond() * 1000000000 + getNano()) - (\bigint)secondsToSubtract * 1000000000 && ((\bigint)getEpochSecond() * 1000000000 + getNano()) - (\bigint)secondsToSubtract * 1000000000 <= (\bigint)31556889864403199L * 1000000000 + 999999999);
    //@   signals_only DateTimeException, ArithmeticException;
    //@ spec_pure
    public Instant minusSeconds(long secondsToSubtract);

    //@ public normal_behavior
    //@   requires (\bigint)-31557014167219200L * 1000000000 <= ((\bigint)getEpochSecond() * 1000000000 + getNano()) - (\bigint)millisToSubtract * 1000000 && ((\bigint)getEpochSecond() * 1000000000 + getNano()) - (\bigint)millisToSubtract * 1000000 <= (\bigint)31556889864403199L * 1000000000 + 999999999;
    //@   ensures ((\bigint)\result.getEpochSecond() * 1000000000 + \result.getNano()) == ((\bigint)getEpochSecond() * 1000000000 + getNano()) - (\bigint)millisToSubtract * 1000000;
    //@ also public exceptional_behavior
    //@   requires !((\bigint)-31557014167219200L * 1000000000 <= ((\bigint)getEpochSecond() * 1000000000 + getNano()) - (\bigint)millisToSubtract * 1000000 && ((\bigint)getEpochSecond() * 1000000000 + getNano()) - (\bigint)millisToSubtract * 1000000 <= (\bigint)31556889864403199L * 1000000000 + 999999999);
    //@   signals_only DateTimeException, ArithmeticException;
    //@ spec_pure
    public Instant minusMillis(long millisToSubtract);

    //@ public normal_behavior
    //@   requires (\bigint)-31557014167219200L * 1000000000 <= ((\bigint)getEpochSecond() * 1000000000 + getNano()) - nanosToSubtract && ((\bigint)getEpochSecond() * 1000000000 + getNano()) - nanosToSubtract <= (\bigint)31556889864403199L * 1000000000 + 999999999;
    //@   ensures ((\bigint)\result.getEpochSecond() * 1000000000 + \result.getNano()) == ((\bigint)getEpochSecond() * 1000000000 + getNano()) - nanosToSubtract;
    //@ also public exceptional_behavior
    //@   requires !((\bigint)-31557014167219200L * 1000000000 <= ((\bigint)getEpochSecond() * 1000000000 + getNano()) - nanosToSubtract && ((\bigint)getEpochSecond() * 1000000000 + getNano()) - nanosToSubtract <= (\bigint)31556889864403199L * 1000000000 + 999999999);
    //@   signals_only DateTimeException, ArithmeticException;
    //@ spec_pure
    public Instant minusNanos(long nanosToSubtract);

    // The number of milliseconds from the epoch, rounded toward negative infinity
    //@ public normal_behavior
    //@   requires Long.MIN_VALUE <= (\bigint)getEpochSecond() * 1000 + getNano() / 1000000 && (\bigint)getEpochSecond() * 1000 + getNano() / 1000000 <= Long.MAX_VALUE;
    //@   ensures \result == (\bigint)getEpochSecond() * 1000 + getNano() / 1000000;
    //@ also public exceptional_behavior
    //@   requires !(Long.MIN_VALUE <= (\bigint)getEpochSecond() * 1000 + getNano() / 1000000 && (\bigint)getEpochSecond() * 1000 + getNano() / 1000000 <= Long.MAX_VALUE);
    //@   signals_only ArithmeticException;
    //@ pure
    public long toEpochMilli();

    //@ also public normal_behavior
    //@   ensures (\result < 0) == (((\bigint)getEpochSecond() * 1000000000 + getNano()) < ((\bigint)otherInstant.getEpochSecond() * 1000000000 + otherInstant.getNano()));
    //@   ensures (\result == 0) == (((\bigint)getEpochSecond() * 1000000000 + getNano()) == ((\bigint)otherInstant.getEpochSecond() * 1000000000 + otherInstant.getNano()));
    //@ pure
    public int compareTo(Instant otherInstant);

    //@ public normal_behavior
    //@   ensures \result == (((\bigint)getEpochSecond() * 1000000000 + getNano()) > ((\bigint)otherInstant.getEpochSecond() * 1000000000 + otherInstant.getNano()));
    //@ pure
    public boolean isAfter(Instant otherInstant);

    //@ public normal_behavior
    //@   ensures \result == (((\bigint)getEpochSecond() * 1000000000 + getNano()) < ((\bigint)otherInstant.getEpochSecond() * 1000000000 + otherInstant.getNano()));
    //@ pure
    public boolean isBefore(Instant otherInstant);

    //@ also public normal_behavior
    //@   ensures \result == (other instanceof Instant && ((Instant)other).getEpochSecond() == getEpochSecond()
    //@                                                && ((Instant)other).getNano() == getNano());
    //@ pure
    public boolean equals(/*@ nullable */ Object other);

    //@ also public normal_behavior
    //@   ensures \result == ((int) (getEpochSecond() ^ (getEpochSecond() >>> 32))) + (51 * getNano());
    //@ pure code_java_math spec_java_math
    public int hashCode();
}
