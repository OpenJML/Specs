    //-RAC@   ensures \result == seconds;
    //@ pure helper
    public long getSeconds();

    // 0 <= getNano() < 10^9, by the invariant
    //@ public normal_behavior
    //-RAC@   ensures \result == nanos;
    //@ pure helper
    public int getNano();

    //@ public normal_behavior
    //@   ensures \result.getSeconds() == seconds && \result.getNano() == getNano();
