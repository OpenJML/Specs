package java.time;

import java.time.temporal.ChronoUnit;
import java.time.temporal.TemporalUnit;

// A Duration is a whole number of nanoseconds, getSeconds() * 10^9 + getNano(), with 0 <= getNano() < 10^9;
// the specifications state results by that exact (\bigint) value. Arithmetic throws ArithmeticException when the
// result does not fit, and also when the implementation's multiplication by a unit length overflows (plusDays etc.).
// Not specified: of(long,TemporalUnit), from, parse, between, plus/minus(long,TemporalUnit), multipliedBy, dividedBy,
// addTo, subtractFrom, truncatedTo, getUnits, toString.
//@ non_null_by_default
public final class Duration implements java.time.temporal.TemporalAmount, Comparable<Duration>, java.io.Serializable {

    public static final Duration ZERO;

    //@ spec_public
    private final long seconds; //-RAC@ in theHashCode;
    //@ spec_public
    private final int nanos; //-RAC@ in theHashCode;

    //-RAC@ public invariant 0 <= nanos && nanos < 1000000000;

    //@ public normal_behavior
    //@   ensures ZERO.getSeconds() == 0 && ZERO.getNano() == 0;
    //@ static_initializer

    // Connects Object.hashCode's specification to this class's hashCode
    //-RAC@ public represents theHashCode = ((int) (seconds ^ (seconds >>> 32))) + (51 * nanos);

    //-RAC@ private normal_behavior
    //-RAC@   requires 0 <= nanos && nanos < 1000000000;
    //-RAC@   ensures this.seconds == seconds && this.nanos == nanos;
    //@ pure
    private Duration(long seconds, int nanos);

    //-RAC@ private normal_behavior
    //-RAC@   requires 0 <= nanoAdjustment && nanoAdjustment < 1000000000;
    //-RAC@   ensures \result.seconds == seconds && \result.nanos == nanoAdjustment;
    //@ spec_pure
    private static Duration create(long seconds, int nanoAdjustment);


    //@ public normal_behavior
    //@   requires Long.MIN_VALUE <= (\bigint)days * 86400 && (\bigint)days * 86400 <= Long.MAX_VALUE;
    //@   ensures \result.getSeconds() == days * 86400 && \result.getNano() == 0;
    //@ also public exceptional_behavior
    //@   requires !(Long.MIN_VALUE <= (\bigint)days * 86400 && (\bigint)days * 86400 <= Long.MAX_VALUE);
    //@   signals_only ArithmeticException;
    //@ spec_pure
    public static Duration ofDays(long days);

    //@ public normal_behavior
    //@   requires Long.MIN_VALUE <= (\bigint)hours * 3600 && (\bigint)hours * 3600 <= Long.MAX_VALUE;
    //@   ensures \result.getSeconds() == hours * 3600 && \result.getNano() == 0;
    //@ also public exceptional_behavior
    //@   requires !(Long.MIN_VALUE <= (\bigint)hours * 3600 && (\bigint)hours * 3600 <= Long.MAX_VALUE);
    //@   signals_only ArithmeticException;
    //@ spec_pure
    public static Duration ofHours(long hours);

    //@ public normal_behavior
    //@   requires Long.MIN_VALUE <= (\bigint)minutes * 60 && (\bigint)minutes * 60 <= Long.MAX_VALUE;
    //@   ensures \result.getSeconds() == minutes * 60 && \result.getNano() == 0;
    //@ also public exceptional_behavior
    //@   requires !(Long.MIN_VALUE <= (\bigint)minutes * 60 && (\bigint)minutes * 60 <= Long.MAX_VALUE);
    //@   signals_only ArithmeticException;
    //@ spec_pure
    public static Duration ofMinutes(long minutes);

    //@ public normal_behavior
    //@   ensures \result.getSeconds() == seconds && \result.getNano() == 0;
    //@ spec_pure
    public static Duration ofSeconds(long seconds);

    //@ public normal_behavior
    //@   requires (\bigint)Long.MIN_VALUE * 1000000000 <= ((\bigint)seconds * 1000000000 + nanoAdjustment) && ((\bigint)seconds * 1000000000 + nanoAdjustment) <= (\bigint)Long.MAX_VALUE * 1000000000 + 999999999;
    //@   ensures ((\bigint)\result.getSeconds() * 1000000000 + \result.getNano()) == ((\bigint)seconds * 1000000000 + nanoAdjustment);
    //@ also public exceptional_behavior
    //@   requires !((\bigint)Long.MIN_VALUE * 1000000000 <= ((\bigint)seconds * 1000000000 + nanoAdjustment) && ((\bigint)seconds * 1000000000 + nanoAdjustment) <= (\bigint)Long.MAX_VALUE * 1000000000 + 999999999);
    //@   signals_only ArithmeticException;
    //@ spec_pure
    public static Duration ofSeconds(long seconds, long nanoAdjustment);

    //@ public normal_behavior
    //@   ensures ((\bigint)\result.getSeconds() * 1000000000 + \result.getNano()) == (\bigint)millis * 1000000;
    //@ spec_pure
    public static Duration ofMillis(long millis);

    //@ public normal_behavior
    //@   ensures ((\bigint)\result.getSeconds() * 1000000000 + \result.getNano()) == nanos;
    //@ spec_pure
    public static Duration ofNanos(long nanos);

    //@ also public normal_behavior
    //@   requires unit == ChronoUnit.SECONDS;
    //@   ensures \result == getSeconds();
    //@ also public normal_behavior
    //@   requires unit == ChronoUnit.NANOS;
    //@   ensures \result == getNano();
    //@ also public exceptional_behavior
    //@   requires unit != ChronoUnit.SECONDS && unit != ChronoUnit.NANOS;
    //@   signals_only java.time.temporal.UnsupportedTemporalTypeException;
    //@ pure
    public long get(/*@ nullable */ TemporalUnit unit);

