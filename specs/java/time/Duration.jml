    //@ also public exceptional_behavior
    //@   requires !((\bigint)Long.MIN_VALUE * 1000000000 <= ((\bigint)getSeconds() * 1000000000 + getNano()) + ((\bigint)duration.getSeconds() * 1000000000 + duration.getNano()) && ((\bigint)getSeconds() * 1000000000 + getNano()) + ((\bigint)duration.getSeconds() * 1000000000 + duration.getNano()) <= (\bigint)Long.MAX_VALUE * 1000000000 + 999999999);
    //@   signals_only ArithmeticException;
    //@ spec_pure
