package java.time;

// A Year holds an ISO proleptic year between MIN_VALUE and MAX_VALUE.
// Not specified: now, from, parse, the TemporalAccessor and Temporal methods (isSupported, range, get, getLong, with,
// plus/minus with a TemporalAmount or TemporalUnit, query, adjustInto, until), isValidMonthDay, format, atDay,
// atMonth, atMonthDay, toString.
//@ non_null_by_default
public final class Year implements java.time.temporal.Temporal, java.time.temporal.TemporalAdjuster,
                                   Comparable<Year>, java.io.Serializable {

    public static final int MIN_VALUE;
    public static final int MAX_VALUE;

    //@ spec_public
    private final int year; //-RAC@ in theHashCode;

    //-RAC@ public invariant MIN_VALUE <= year && year <= MAX_VALUE;

    // Connects Object.hashCode's specification to this class's hashCode
    //-RAC@ public represents theHashCode = year;

    private Year(int year);

    //@ public normal_behavior
    //@   requires MIN_VALUE <= isoYear && isoYear <= MAX_VALUE;
    //@   ensures \result.getValue() == isoYear;
    //@ also public exceptional_behavior
    //@   requires isoYear < MIN_VALUE || isoYear > MAX_VALUE;
    //@   signals_only DateTimeException;
    //@ spec_pure
    public static Year of(int isoYear);

    // The ISO proleptic leap-year rule
    //@ public normal_behavior
    //@   ensures \result == (year % 4 == 0 && (year % 100 != 0 || year % 400 == 0));
    //@ pure
    public static boolean isLeap(long year);

    // MIN_VALUE <= getValue() <= MAX_VALUE, by the invariant
    //@ public normal_behavior
    //-RAC@   ensures \result == year;
    //@ pure helper
    public int getValue();

    //@ public normal_behavior
    //@   ensures \result == isLeap(getValue());
    //@ pure
    public boolean isLeap();

    //@ public normal_behavior
    //@   ensures \result == (isLeap(getValue()) ? 366 : 365);
    //@ pure
    public int length();

    //@ public normal_behavior
    //@   requires MIN_VALUE <= (\bigint)getValue() + yearsToAdd && (\bigint)getValue() + yearsToAdd <= MAX_VALUE;
    //@   ensures \result.getValue() == getValue() + yearsToAdd;
    //@ also public exceptional_behavior
    //@   requires !(MIN_VALUE <= (\bigint)getValue() + yearsToAdd && (\bigint)getValue() + yearsToAdd <= MAX_VALUE);
    //@   signals_only DateTimeException;
    //@ spec_pure
    public Year plusYears(long yearsToAdd);

    //@ public normal_behavior
    //@   requires MIN_VALUE <= (\bigint)getValue() - yearsToSubtract && (\bigint)getValue() - yearsToSubtract <= MAX_VALUE;
    //@   ensures \result.getValue() == getValue() - yearsToSubtract;
    //@ also public exceptional_behavior
    //@   requires !(MIN_VALUE <= (\bigint)getValue() - yearsToSubtract && (\bigint)getValue() - yearsToSubtract <= MAX_VALUE);
    //@   signals_only DateTimeException;
    //@ spec_pure
    public Year minusYears(long yearsToSubtract);

    //@ also public normal_behavior
    //@   ensures \result == getValue() - other.getValue();
    //@ pure
    public int compareTo(Year other);

    //@ public normal_behavior
    //@   ensures \result == (getValue() > other.getValue());
    //@ pure
    public boolean isAfter(Year other);

    //@ public normal_behavior
    //@   ensures \result == (getValue() < other.getValue());
    //@ pure
    public boolean isBefore(Year other);

    //@ also public normal_behavior
    //@   ensures \result == (obj instanceof Year && ((Year)obj).getValue() == getValue());
    //@ pure
    public boolean equals(/*@ nullable */ Object obj);

    //@ also public normal_behavior
    //@   ensures \result == getValue();
    //@ pure
    public int hashCode();
}
