    //@ spec_public
    private int begin; //@ in objectState;
    //@ spec_public
    private int end; //@ in objectState;
    //@ spec_public
    private int pos; //@ in objectState;

    //-RAC@ public invariant 0 <= begin && begin <= pos && pos <= end && end <= text.chars.length;

