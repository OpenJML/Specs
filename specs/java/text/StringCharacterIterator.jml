    //@   ensures getBeginIndex() == begin && getEndIndex() == end && getIndex() == pos;
    //-RAC@   ensures this.text == text;
    //@ also public exceptional_behavior
    //@   requires text == null;
    //@   signals_only NullPointerException;
    //@ also public exceptional_behavior
    //@   requires text != null && (begin < 0 || begin > end || end > text.length() || pos < begin || pos > end);
    //@   signals_only IllegalArgumentException;
    //@ pure
    public StringCharacterIterator(/*@ nullable */ String text, int begin, int end, int pos);

    //@ public normal_behavior
    //@   requires text != null;
    //@   assignable objectState;
    //@   ensures getBeginIndex() == 0 && getEndIndex() == text.length() && getIndex() == 0;
    //-RAC@   ensures this.text == text;
    //@ also public exceptional_behavior
    //@   requires text == null;
    //@   assignable \nothing;
    //@   signals_only NullPointerException;
    public void setText(/*@ nullable */ String text);

    //-RAC@ also public normal_behavior
    //-RAC@   assignable pos;
    //-RAC@   ensures text == \old(text);
    public char first();

    //-RAC@ also public normal_behavior
    //-RAC@   assignable pos;
    //-RAC@   ensures text == \old(text);
    public char last();

    //-RAC@ also public normal_behavior
    //-RAC@   assignable pos;
    //-RAC@   ensures text == \old(text);
    public char next();

    //-RAC@ also public normal_behavior
    //-RAC@   assignable pos;
    //-RAC@   ensures text == \old(text);
    public char previous();

    //-RAC@ also public normal_behavior
    //-RAC@   requires begin <= p && p <= end;
    //-RAC@   assignable pos;
    //-RAC@   ensures text == \old(text);
    public char setIndex(int p);

    //-RAC@ also public normal_behavior
    //-RAC@   requires pos < end;
    //-RAC@   ensures \result == text.charAt(pos);
    //-RAC@ also public normal_behavior
    //-RAC@   requires pos == end;
    //-RAC@   ensures \result == DONE;
    //@ pure
    public char current();

    //@ also public normal_behavior
    //-RAC@   ensures \result == begin;
    //@ pure
    public int getBeginIndex();

    //@ also public normal_behavior
    //-RAC@   ensures \result == end;
    //@ pure
