package org.jmlspecs.lang.internal;

import org.jmlspecs.lang.IJmlPrimitiveType;
import org.jmlspecs.lang.IJmlIntArrayLike;


//@ immutable no_state non_null_by_default
public final class string implements IJmlPrimitiveType, IJmlIntArrayLike, Comparable<string> {

    private final String value; //-RAC@ in length;
    
    //-RAC@ model public final \bigint length;
    //-RAC@ public final invariant \bigint.zero <= length;
    //-RAC-ESC+JMLSTRING@ private final invariant value != null && length == value.length();

    //@ spec_public
    private final static String emptyString;

    public final static string empty;
    
    //-RAC@ ensures emptyString.length() == 0;
    //-RAC@ ensures empty.length == 0;
    //-RAC@ static_initializer
    
    //@ private normal_behavior
    //@       requires true;
    //-RAC@   ensures length == s.length();
    //-RAC-ESC+JMLSTRING@   ensures value == s;
    //-RAC@   ensures \forall int i; 0 <= i < s.length(); this[i] == s.charAt(i);
    private string(String s);  // s is non_null by default

    //@ public normal_behavior
    //@       requires true;
    //-RAC@   ensures \result.length == 0;
    //@ also private normal_behavior
    //@       requires true;
    //-RAC@   ensures \result.value == \string.emptyString;
    public static string empty();
    
    //@ public normal_behavior
    //@       requires true;
    //-RAC@   ensures \result <==> this.length == \bigint.zero;
    //@ helper
    public boolean isEmpty();
    
    //@ public normal_behavior
    //@       requires true;
    //-RAC@   ensures \result == length;
    //@ helper
    public bigint length();
    
    //@ private normal_behavior
    //@       requires true;
    //-RAC@   ensures \result == value;
    //@ helper
    public String toString();
    
    //@ public normal_behavior
    //@       requires true;
    //-RAC@   ensures \result.length == s.length();
    //-RAC@   ensures \forall int i; 0 <= i < s.length(); \result[i] == s.charAt(i);
    //@ also private normal_behavior
    //@       requires true;
    //-RAC@   ensures \result.value == s;    
    public static string of(String s);  // s is non_null by default
    
    //@ public normal_behavior
    //@       requires true;
    //-RAC@   ensures \result.length == 1;
    //-RAC@   ensures \result.get(0) == c;
    public static string of(char c);
    
    //@ public normal_behavior
    //-ESC@   requires 0 <= i < length();
    //-RAC@   requires 0 <= i < length;
    //-RAC@   ensures \result == this[i];
    //@ helper
    public char get(bigint i);
    
    //@ public normal_behavior
    //@   requires true;
    //-RAC@   ensures 0 <= i < length() ==> \result == this[i];
    //@ helper
    public char getUnchecked(bigint i);
    
    //@ public normal_behavior
    //@       requires true;
    //-RAC@   ensures this == s <==> \result == 0;
    //-RAC@   ensures this != s <==> \result != 0;
    //-RAC@   ensures this >= s <==> \result >= 0;
    //-RAC@   ensures this <= s <==> \result <= 0;
    //-RAC@   ensures this > s <==> \result > 0;
    //-RAC@   ensures this < s <==> \result < 0;
    public int compareTo(string s);  // s is non_null by default
 
    //@ public normal_behavior
    //@       requires true;
    //-RAC@   ensures \result == (this == s);
    //-RAC@   ensures \result == (this.length == s.length && \forall \bigint i; 0 <= i < length; this[i] == s[i]);
    //@ helper
    public boolean eq(string s);  // s is non_null by default
    
    //@ public normal_behavior
    //@       requires true;
    //-RAC@   ensures \result == !eq(s);
    //@ helper
    public boolean ne(string s);  // s is non_null by default
    
    //@ public normal_behavior
    //@       requires true;
    //-RAC@   ensures \result == (this >= s);
    public boolean ge(string s);  // s is non_null by default
    
    //@ public normal_behavior
    //@       requires true;
    //-RAC@   ensures \result == (this > s);
    public boolean gt(string s);  // s is non_null by default
    
    //@ public normal_behavior
    //@       requires true;
    //-RAC@   ensures \result == (this <= s);
    public boolean le(string s);  // s is non_null by default
    
    //@ public normal_behavior
    //@       requires true;
    //-RAC@   ensures \result == (this < s);
    public boolean lt(string s);  // s is non_null by default
    
    //@ public normal_behavior
    //-ESC@   requires length() > 0;
    //-RAC@   requires length > 0;
    //-RAC@   ensures \result == this[0];
    //@ helper
    public char head();
    
    //@ public normal_behavior
    //-ESC@   requires 0 <= k <= length();
    //-RAC@   requires 0 <= k <= length;
    //-RAC@   ensures \forall \bigint i; 0 <= i < k; \result[i] == this[i];
    //-RAC@   ensures \result.length == k;
    public string head(bigint k);
    
    //@ public normal_behavior
    //-ESC@   requires length() > 0;
    //-RAC@   requires length > 0;
    //-RAC@   ensures \forall \bigint i; 0 <= i < length-1; \result[i] == this[i+1];
    //-RAC@   ensures \result.length == this.length-1;
    public string tail();
    
    //@ public normal_behavior
    //-ESC@   requires length() >= k;
    //-RAC@   requires length >= k;
    //-RAC@   ensures \forall \bigint i; 0 <= i < length-k; \result[i] == this[i+k];
    //-RAC@   ensures \result.length == this.length-k;
    //-RAC@   ensures \result == substring(k,length);
    public string tail(bigint k);
    
    //@ public normal_behavior
    //@       requires true;
    //-RAC@   ensures \result.length == this.length+1;
    //-RAC@   ensures \forall \bigint i; 0 <= i < length; \result[i] == this[i];
    //-RAC@   ensures \result[length] == v;
    public string append(char v);

    //@ public normal_behavior
    //@       requires true;
    //-RAC@   ensures \result.length == this.length+s.length();
    //-RAC@   ensures \forall \bigint i; 0 <= i < length; \result[i] == this[i];
    // -RAC@   ensures \forall int i; 0 <= i < s.length(); \result[i+length] == s.charAt(i);
    //-RAC@   ensures \forall int i; length <= i < length+s.length(); \result[i] == s.charAt(i-length.intValue());
    public string append(String s);

    //@ public normal_behavior
    //@       requires true;
    //-RAC@   ensures \result.length == this.length + s.length;
    //-RAC@   ensures \forall \bigint i; 0 <= i < length; \result[i] == this[i];
    // -RAC@   ensures \forall \bigint i; 0 <= i < s.length; \result[i+length] == s[i];
    //-RAC@   ensures \forall \bigint i; length <= i < length+s.length; \result[i] == s[i-length];
    public string append(string s);

    //@ public behavior
    //-ESC@   requires 0 <= i <= length();
    //-RAC@   requires 0 <= i <= length;
    //-RAC@   ensures \result[i] == v;
    //-RAC@   ensures \forall \bigint j; j != i; \result[j] == this[j];
    //-RAC@   ensures \result.length == this.length;
    public string put(bigint i, char v);
    
    //@ public normal_behavior
    //-ESC@   requires 0 <= ii <= this.length();
    //-RAC@   requires 0 <= ii <= this.length;
    //-RAC@   ensures \forall \bigint i; 0 <= i < ii; \result[i] == this[i];
    //-RAC@   ensures \result[ii] == v;
    //-RAC@   ensures \forall \bigint i; ii < i < length+1; \result[i] == this[i-1];
    //-RAC@   ensures \result.length == this.length+1;
    public string insert(bigint ii, char v);

    //@ public normal_behavior
    //-ESC@   requires 0 <= ii < this.length();
    //-RAC@   requires 0 <= ii < this.length;
    //-RAC@   ensures \forall \bigint i; 0 <= i < ii; \result[i] == this[i];
    //-RAC@   ensures \forall \bigint i; ii <= i < length-1; \result[i] == this[i+1];
    //-RAC@   ensures \result.length == this.length-1;
    public string remove(bigint ii);

    //@ public normal_behavior
    //-ESC@   requires 0 <= start <= end <= length();
    //-RAC@   requires 0 <= start <= end <= length;
    //-RAC@   ensures \result.length == end - start;
    //-RAC@   ensures \forall \bigint i; 0 <= i < end-start; \result[i] == this[i+start];
    public string substring(bigint start, bigint end);
    
    //@ public normal_behavior
    //-ESC@   requires 0 <= start <= length();
    //-RAC@   requires 0 <= start <= length;
    //-RAC@   ensures \result.length == length - start;
    //-RAC@   ensures \forall \bigint i; 0 <= i < length-start; \result[i] == this[i+start];
    public string substring(bigint start);
    
    //@ requires false; // Not defined for JML primitive types. Use eq.
    public boolean equals(Object o);
    
    //@ public normal_behavior
    //@ requires true;
    //-RAC@   ensures \result == (this.eq(s));
    public boolean equals(string s);

    //-RAC axiom \forall \string s; \forall \string ss; s.eq(ss) ==> s.hashCode() == ss.hashCode();

    //@ public normal_behavior
    //@   requires true;
    public int hashCode();
}
